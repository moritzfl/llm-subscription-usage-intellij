{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "gradle"
  ],
  "gradle": {
    "managerFilePatterns": [
      "/(^|/)build\\.gradle(\\.kts)?$/",
      "/(^|/)settings\\.gradle(\\.kts)?$/",
      "/(^|/)gradle\\.properties$/",
      "/(^|/)gradle/libs\\.versions\\.toml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Keep kotlinx-coroutines-test on the coroutines line bundled with the target IntelliJ platform. The test jar runs without transitives against the platform core.",
      "matchPackageNames": [
        "org.jetbrains.kotlinx:kotlinx-coroutines-test",
        "org.jetbrains.kotlinx:kotlinx-coroutines-test-jvm"
      ],
      "allowedVersions": "<1.11.0"
    }
  ]
}
